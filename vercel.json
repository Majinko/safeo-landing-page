{
  "redirects": [
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demo",
      "destination": "/demo/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/demo/:path*",
      "destination": "/demo/index.html"
    }
  ],
  "headers": [
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/demo/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/demo/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
